# Blue Team Analysis Agent — copy to .env and fill in.
# The .env file is git-ignored and must never be committed.

# --- LLM backend -----------------------------------------------------------
# modal | openai | vllm | ollama | azure | offline
LLM_PROVIDER=modal

# Endpoint root of the Modal-hosted, OpenAI-compatible inference server.
# MUST end in /v1 (the agent appends it if you forget).
MODAL_LLM_BASE_URL=https://your-workspace--your-vllm-app.modal.run/v1

# Bearer token for the endpoint above.
MODAL_API_KEY=

# Modal SDK credentials — only needed for `modal deploy modal_app.py`,
# not for local runs. Generate with `modal token new`.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Generation ------------------------------------------------------------
MODEL_NAME=qwen3-32b
TEMPERATURE=0.2
MAX_TOKENS=4096

# Qwen-style hybrid reasoning. Leave false unless MAX_TOKENS is generous:
# reasoning models can spend the whole budget on the thinking trace.
ENABLE_THINKING=false

# --- Transport & reliability ----------------------------------------------
# Modal scales to zero, so the first request after idle cold-starts slowly.
REQUEST_TIMEOUT=180
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# Findings analysed in parallel.
CONCURRENCY=4

# Fall back to the deterministic heuristic analyser when the LLM is
# unreachable, instead of failing the run. Recommended for demos.
ALLOW_OFFLINE_FALLBACK=true

# --- I/O -------------------------------------------------------------------
INPUT_PATH=input/sample_report.json
OUTPUT_DIR=output
LOG_LEVEL=INFO

# --- HTTP API (serve_api.py) ----------------------------------------------
# Platform port map: 3000 frontend, 8000 Red Agent, 8001 Blue Agent.
BLUE_API_HOST=0.0.0.0
BLUE_API_PORT=8001

# Concurrent analyses. Each one already fans out internally by CONCURRENCY,
# so raising this multiplies load on the LLM endpoint.
BLUE_API_WORKERS=2

# Finished jobs retained in memory before the oldest are evicted.
BLUE_API_JOB_HISTORY=200

# Where per-job artefacts are written (default: output/api).
# BLUE_API_ARTIFACT_DIR=output/api

# CORS. Any loopback origin is allowed by default, which covers the frontend on
# localhost:3000 even if its dev server hops to another port. Pin real origins
# for a deployment, comma-separated, or "*" to allow all.
# BLUE_API_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Auto-reload on code changes (development only).
# BLUE_API_RELOAD=true

# Default Red Agent API root used when a request omits red_agent_url.
# RED_AGENT_URL=http://127.0.0.1:8000

# --- Compatibility ---------------------------------------------------------
# An existing Red Agent .env already defines these; the Blue Agent reads them
# as fallbacks, so you can share one environment file across both agents.
# SAFEGUARD_LLM_BASE_URL=
# SAFEGUARD_LLM_API_KEY=
# SAFEGUARD_LLM_MODEL=
